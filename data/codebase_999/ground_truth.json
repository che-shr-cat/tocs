  "design_rationales": [
    {
      "id": "dr-001",
      "question": "Why is there a separate text_processor/models.py instead of defining data types within each stage?",
      "answer": "Centralizing data types in models.py prevents circular imports between stages and ensures type consistency across the pipeline.",
      "affected_modules": [
        "text_processor/models.py",
        "text_processor/stages/mod_a.py",
        "text_processor/stages/mod_b.py",
        "text_processor/stages/mod_c.py",
        "text_processor/stages/mod_d.py",
        "text_processor/stages/mod_e.py",
        "text_processor/stages/mod_f.py"
      ],
      "downstream_effects": [
        "Moving types into stages would create circular imports",
        "Type changes would require editing multiple files",
        "Stages could no longer be tested independently"
      ]
    },
    {
      "id": "dr-002",
      "question": "Why do all stages inherit from StageBase in text_processor/base.py?",
      "answer": "A common base class enforces a uniform process() interface, enables the registry to load stages generically, and allows middleware to wrap any stage without special-casing.",
      "affected_modules": [
        "text_processor/base.py",
        "text_processor/stages/mod_a.py",
        "text_processor/stages/mod_b.py",
        "text_processor/stages/mod_c.py",
        "text_processor/stages/mod_d.py",
        "text_processor/stages/mod_e.py",
        "text_processor/stages/mod_f.py",
        "text_processor/adapters/mod_g.py",
        "text_processor/adapters/mod_h.py"
      ],
      "downstream_effects": [
        "Removing StageBase would break registry auto-discovery",
        "Middleware would need per-stage wiring logic",
        "Adding a new stage would require updating the runner"
      ]
    },
    {
      "id": "dr-003",
      "question": "Why does text_processor/runner.py use text_processor/registry.py to resolve stages instead of importing them directly?",
      "answer": "Registry-based resolution allows stage ordering to be config-driven. Direct imports would hard-code the pipeline structure and require code changes to add, remove, or reorder stages.",
      "affected_modules": [
        "text_processor/runner.py",
        "text_processor/registry.py",
        "text_processor/config.py",
        "text_processor/stages/mod_a.py",
        "text_processor/stages/mod_b.py",
        "text_processor/stages/mod_c.py",
        "text_processor/stages/mod_d.py",
        "text_processor/stages/mod_e.py",
        "text_processor/stages/mod_f.py"
      ],
      "downstream_effects": [
        "Direct imports would hide architecture from config",
        "Stage ordering changes would require code edits",
        "Dynamic stage loading (e.g., plugins) would be impossible"
      ]
    },
    {
      "id": "dr-004",
      "question": "Why are there adapter modules wrapping some stages instead of exposing stages directly?",
      "answer": "Adapters provide a stable external interface. If a stage's internal implementation changes, only its adapter needs updating, not every external consumer.",
      "affected_modules": [
        "text_processor/adapters/mod_g.py",
        "text_processor/adapters/mod_h.py",
        "text_processor/stages/mod_a.py",
        "text_processor/stages/mod_b.py",
        "text_processor/stages/mod_c.py",
        "text_processor/stages/mod_d.py",
        "text_processor/stages/mod_e.py",
        "text_processor/stages/mod_f.py"
      ],
      "downstream_effects": [
        "Direct stage access would couple external code to internals",
        "Stage API changes would break all consumers simultaneously",
        "Testing external integrations would require full stage setup"
      ]
    },
    {
      "id": "dr-005",
      "question": "Why is logging/retry implemented as middleware modules rather than embedded in each stage?",
      "answer": "Middleware modules apply cross-cutting concerns uniformly. Embedding logging/retry in each stage would duplicate code and risk inconsistent behavior across stages.",
      "affected_modules": [
        "text_processor/middleware/mod_i.py",
        "text_processor/middleware/mod_j.py",
        "text_processor/stages/mod_a.py",
        "text_processor/stages/mod_b.py",
        "text_processor/stages/mod_c.py",
        "text_processor/stages/mod_d.py",
        "text_processor/stages/mod_e.py",
        "text_processor/stages/mod_f.py",
        "text_processor/runner.py"
      ],
      "downstream_effects": [
        "Per-stage logging would diverge in format and verbosity",
        "Retry logic would be duplicated and potentially inconsistent",
        "Adding a new cross-cutting concern would touch every stage"
      ]
    }
